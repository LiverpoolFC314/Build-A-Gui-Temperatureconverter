from tkinter import*
import random
from tkinter import messagebox
from tkinter import filedialog 
import os
import pygame
pygame.mixer.init()
current_song=""
paused=False
playlist=[]
current_index=0
guiscreen = Tk()
guiscreen.geometry("900x800")
guiscreen.title("")
guiscreen.config(background="ghost white")
def load_music():
    global current_song
    files=filedialog.askopenfilenames(filetypes=[("Audio Files","*.mp3 *.wav *.ogg")])
    
    playlist=list(files)

    current_song=playlist[current_index]
    title1.config(text=os.path.basename(current_song))
def play_music():
    global paused
    if paused:
        pygame.mixer.music.unpause()
        paused=False
    else:
        pygame.mixer.music.load(current_song)
        pygame.mixer.music.play()
def stop_music():
    global paused
    pygame.mixer.music.stop() 
def pause_music():
    global paused
    pygame.mixer.music.pause()
    paused=True
def set_volume(val):
    volume=float(val)/100
    pygame.mixer.music.set_volume(volume)
def next_song():
    global current_index
    if playlist and current_index<len(playlist)-1:
        current_index+=1
        play_music()
title1=Label(guiscreen,text="No songs loaded",fg="gray2",bg="ghost white",font=("Arial",25,"italic"))
title1.place(x=200,y=30)
B1=Button(text="Load",command=load_music)
B1.place(x=100,y=120)
B2=Button(text="Prev")
B2.place(x=100,y=300)
B3=Button(text="Play",command=play_music)
B3.place(x=100,y=480)
B4=Button(text="Stop",command=stop_music)
B4.place(x=250,y=120)
B5=Button(text="Next")
B5.place(x=250,y=300)
B6=Button(text="Pause",command=pause_music)
B6.place(x=250,y=480)
title2=Label(guiscreen,text="Volume",fg="gray2",bg="ghost white",font=("Arial",25,"italic"))
title2.place(x=100,y=680)
volume_slider=Scale(guiscreen,from_=0,to=100,orient="horizontal",command=set_volume)
volume_slider.set(50)
volume_slider.place(x=100,y=750)
guiscreen.mainloop()
